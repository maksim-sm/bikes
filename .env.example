# Copy to .env.local and adjust. Never commit a file with real values.
# Catalogue and owners: docs/environments.md (ADR-0043).
# Every application variable is validated in src/lib/config.ts.

# ---------------------------------------------------------------------------
# Shared (all named environments)
# ---------------------------------------------------------------------------

# Process mode: development (local) | test (Vitest) | production (staging + live)
NODE_ENV=development

# Public origin. Staging and production must be https:// (enforced at next start).
APP_URL=http://localhost:3000

# Catalogue locale. Russian only (ADR-0009, ADR-0033). Timezone and BYN
# formatting come from the locale registry, not from extra env vars.
APP_LOCALE=ru

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Local — owner: the developer of this checkout
# ---------------------------------------------------------------------------

# PostgreSQL for `pnpm dev` and Prisma CLI. Local default is bikes:bikes.
# Reproduce / backup / restore: docs/database.md
DATABASE_URL=postgresql://bikes:bikes@localhost:5432/bikes
# DATABASE_ADMIN_URL=postgresql://bikes:bikes@localhost:5432/postgres
# BACKUP_DIR=backups

# Signs guest-cart cookies. ≥32 characters.
# Local may leave this empty (compiled-in fallback). Staging and production
# must set a unique value. Generate with: openssl rand -base64 32
# Owner (staging/production): platform / security. Never share those two.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Test — owner: engineering (CI and the integration harness)
# ---------------------------------------------------------------------------

# Isolated database for `pnpm test:integration`. Never the local `bikes` DB.
# Created automatically if missing. CI sets these on the Postgres 16 service.
# TEST_DATABASE_URL=postgresql://bikes:bikes@localhost:5432/bikes_test
# TEST_DATABASE_ADMIN_URL=postgresql://bikes:bikes@localhost:5432/postgres

# Playwright only. Keeps the e2e `next dev` cache out of `.next`.
# BIKES_NEXT_DIST_DIR=.next-e2e

# ---------------------------------------------------------------------------
# Staging / production — owner: platform
# ---------------------------------------------------------------------------
# Same build artifact. Different hostname, DATABASE_URL, and AUTH_SECRET.
# Deploy: migrate that environment's database, then
#   NODE_ENV=production pnpm env:check
# then `next start`. Do not set NEXT_PHASE. Do not reuse local or CI
# credentials. See docs/environments.md.

# ---------------------------------------------------------------------------
# Not yet read by the application. Listed so the eventual shape is visible.
# Do not add these to config.ts until code uses them (a missing value must
# mean a real problem). Owner named for when they become real.
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=mock          # owner: finance + platform
# MEDIA_DRIVER=filesystem        # owner: platform
# Local uploads land in storage/media (gitignored). Production will swap the
# MediaStore implementation; catalog rows keep opaque keys.
