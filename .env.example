# Copy to .env.local and adjust. Never commit a file with real values.
# Every variable here is declared and validated in src/lib/config.ts; adding a
# variable anywhere else in the codebase is a boundary violation.

# Node environment: development | test | production
NODE_ENV=development

# Public origin of the site. Used for absolute URLs and payment return URLs.
APP_URL=http://localhost:3000

# Default and fallback locale. Russian only for now (ADR-0009).
APP_LOCALE=ru

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=debug

# PostgreSQL. Required by Prisma CLI and by `src/lib/db.ts`.
DATABASE_URL=postgresql://bikes:bikes@localhost:5432/bikes

# ---------------------------------------------------------------------------
# Not yet used. Listed so the eventual shape is visible, but deliberately not
# in the validation schema: config.ts validates only what the code reads today,
# so a missing value always means a real problem.
# ---------------------------------------------------------------------------
# AUTH_SECRET=
# PAYMENT_PROVIDER=mock
# MEDIA_DRIVER=filesystem
# Local uploads land in storage/media (gitignored). Production will swap the
# MediaStore implementation; catalog rows keep opaque keys.
