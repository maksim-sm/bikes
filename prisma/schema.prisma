// Prisma schema for the bikes store.
//
// One file, one database. Table ownership is declared by the section headers
// below and is enforced by review (ADR-0004): a module's repository may only
// touch the tables in its section. Foreign keys across sections are allowed
// for referential integrity; the referencing module still must not *read*
// the referenced table.
//
// Money is integer minor units (kopeks), never floats (ADR-0010).
// Timestamps are timestamptz. Identifiers are UUID v4 generated by Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF

  @@map("user_role")
}

enum StaffRole {
  ADMIN
  MANAGER
  INVENTORY
  ORDER_MANAGEMENT

  @@map("staff_role")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("product_status")
}

enum BicycleType {
  ROAD
  MTB
  GRAVEL
  CITY
  KIDS

  @@map("bicycle_type")
}

enum ProductMediaRole {
  PRIMARY
  GALLERY

  @@map("product_media_role")
}

enum VariantStatus {
  ACTIVE
  INACTIVE

  @@map("variant_status")
}

enum OrderStatus {
  PLACED
  CANCELLED
  COMPLETED

  @@map("order_status")
}

/// Authoritative on `payments.status`; copied onto `orders.payment_status`
/// so admin lists can filter without joining. The payments module still does
/// not write order rows — the orders module updates the copy from events.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum FulfillmentStatus {
  UNFULFILLED
  ASSIGNED
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED

  @@map("fulfillment_status")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

enum DeliveryRecordStatus {
  ASSIGNED
  SHIPPED
  DELIVERED
  FAILED

  @@map("delivery_status")
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED

  @@map("inventory_reservation_status")
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  EXPIRE
  COMMIT

  @@map("inventory_movement_type")
}

// ===========================================================================
// identity
// Owns: users, credentials, roles, customer profiles, addresses, wishlists.
// ===========================================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CUSTOMER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile    CustomerProfile?
  addresses  Address[]
  carts      Cart[]
  wishlist   Wishlist?
  orders     Order[]
  auditLogs  AuditLog[]
  sessions   AuthSession[]
  authTokens AuthToken[]
  staffRoles UserStaffRole[]

  @@index([role], map: "users_role_idx")
  @@map("users")
}

/// Staff job titles. Customers have none. A staff user may hold several.
model UserStaffRole {
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role], map: "user_staff_roles_role_idx")
  @@map("user_staff_roles")
}

/// Opaque session: the cookie holds the raw token; only `token_hash` is stored.
model AuthSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

/// One-time email-verify and password-reset tokens. Stored hashed, like sessions.
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "auth_tokens_user_id_type_idx")
  @@map("auth_tokens")
}

model CustomerProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name") @db.VarChar(80)
  lastName  String   @map("last_name") @db.VarChar(80)
  phone     String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String   @db.VarChar(40)
  recipientName String   @map("recipient_name") @db.VarChar(160)
  phone         String   @db.VarChar(32)
  countryCode   String   @default("BY") @map("country_code") @db.Char(2)
  region        String   @db.VarChar(80)
  city          String   @db.VarChar(80)
  street        String   @db.VarChar(160)
  postalCode    String   @map("postal_code") @db.VarChar(16)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique "one default address per user" is added in the migration SQL:
  // addresses_one_default_per_user_uidx. Prisma cannot express WHERE is_default.
  @@index([userId], map: "addresses_user_id_idx")
  @@map("addresses")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, productId], map: "wishlist_items_wishlist_id_product_id_key")
  @@index([productId], map: "wishlist_items_product_id_idx")
  @@map("wishlist_items")
}

// ===========================================================================
// catalog
// Owns: brands, categories, products, variants, product–media links.
// Does not own: displayed prices (pricing), image bytes (media), stock
// (inventory — one inventory_items row per variant).
// ===========================================================================

model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  locale      String   @default("ru") @db.VarChar(5)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  locale      String   @default("ru") @db.VarChar(5)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId], map: "categories_parent_id_idx")
  @@map("categories")
}

model Product {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId       String        @map("brand_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  slug          String        @unique @db.VarChar(120)
  name          String        @db.VarChar(200)
  description   String        @db.Text
  locale        String        @default("ru") @db.VarChar(5)
  status        ProductStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(6)
  bicycleType   BicycleType   @map("bicycle_type")
  frameMaterial String?       @map("frame_material") @db.VarChar(80)
  groupset      String?       @db.VarChar(80)
  brakeType     String?       @map("brake_type") @db.VarChar(40)
  modelYear     Int?          @map("model_year")
  warrantyMonths Int?         @map("warranty_months")
  warrantyText  String?       @map("warranty_text") @db.VarChar(200)
  /// Denormalized search document. Triggers keep it in sync; the GIN tsvector
  /// lives only in SQL (`products.search_vector`) so Prisma never writes it.
  searchText    String        @default("") @map("search_text") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  wishlistedBy WishlistItem[]

  // Storefront listing: published products in a category, newest first.
  @@index([categoryId, status, publishedAt(sort: Desc)], map: "products_category_status_published_idx")
  @@index([brandId, status], map: "products_brand_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "products_status_created_idx")
  @@index([bicycleType, status], map: "products_bicycle_type_status_idx")
  @@index([frameMaterial], map: "products_frame_material_idx")
  @@index([groupset], map: "products_groupset_idx")
  @@map("products")
}

model ProductVariant {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String        @unique @db.VarChar(64)
  barcode        String?       @unique @db.VarChar(64)
  frameSize      String        @map("frame_size") @db.VarChar(16)
  wheelSize      String        @map("wheel_size") @db.VarChar(16)
  color          String        @db.VarChar(80)
  listPriceMinor Int           @map("list_price_minor")
  currency       String        @default("BYN") @db.Char(3)
  status         VariantStatus @default(ACTIVE)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  inventory  InventoryItem?
  media      VariantMedia[]

  @@unique([productId, frameSize, color, wheelSize], map: "product_variants_product_id_size_color_key")
  @@index([productId, isActive], map: "product_variants_product_id_is_active_idx")
  @@index([productId, status], map: "product_variants_product_id_status_idx")
  @@index([frameSize], map: "product_variants_frame_size_idx")
  @@index([wheelSize], map: "product_variants_wheel_size_idx")
  @@index([listPriceMinor], map: "product_variants_list_price_minor_idx")
  @@map("product_variants")
}

model ProductMedia {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String            @map("product_id") @db.Uuid
  mediaId   String            @map("media_id") @db.Uuid
  role      ProductMediaRole  @default(GALLERY)
  sortOrder Int               @default(0) @map("sort_order")
  alt       String            @db.VarChar(200)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId], map: "product_media_product_id_media_id_key")
  @@index([productId, sortOrder], map: "product_media_product_id_sort_order_idx")
  @@map("product_media")
}

model VariantMedia {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String           @map("variant_id") @db.Uuid
  mediaId   String           @map("media_id") @db.Uuid
  role      ProductMediaRole @default(GALLERY)
  sortOrder Int              @default(0) @map("sort_order")
  alt       String           @db.VarChar(200)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([variantId, mediaId], map: "variant_media_variant_id_media_id_key")
  @@index([variantId, sortOrder], map: "variant_media_variant_id_sort_order_idx")
  @@map("variant_media")
}

// ===========================================================================
// media
// Owns: stored objects. Other modules keep opaque keys / mediaId, never URLs.
// ===========================================================================

model MediaAsset {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String   @unique @db.VarChar(255)
  contentType  String   @map("content_type") @db.VarChar(100)
  byteSize     Int      @map("byte_size")
  width        Int?
  height       Int?
  originalName String?  @map("original_name") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products ProductMedia[]
  variants VariantMedia[]

  @@map("media")
}

// ===========================================================================
// cart
// Owns: carts and line items. Guest carts are keyed by guestToken; a signed-in
// user has at most one cart (partial unique index in the migration SQL).
// ===========================================================================

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]
  reservations  InventoryReservation[]

  @@index([userId], map: "carts_user_id_idx")
  @@map("carts")
}

model CartItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId], map: "cart_items_cart_id_product_variant_id_key")
  @@index([productVariantId], map: "cart_items_product_variant_id_idx")
  @@map("cart_items")
}

// ===========================================================================
// orders
// Owns: the commercial agreement, its line items, and the denormalized
// payment/fulfillment projections. Does not own payment execution or the
// physical shipment.
//
// Line items and the shipping/customer columns are snapshots taken at
// placement. Catalogue prices and the customer's address book may change
// afterwards; this row must not.
// ===========================================================================

model Order {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number String @unique @db.VarChar(20)

  userId String? @map("user_id") @db.Uuid

  status            OrderStatus        @default(PLACED)
  paymentStatus     PaymentStatus      @default(PENDING) @map("payment_status")
  fulfillmentStatus FulfillmentStatus  @default(UNFULFILLED) @map("fulfillment_status")

  currency           String @default("BYN") @db.Char(3)
  subtotalMinor      Int    @map("subtotal_minor")
  deliveryCostMinor  Int    @map("delivery_cost_minor")
  totalMinor         Int    @map("total_minor")

  deliveryMethodCode String @map("delivery_method_code") @db.VarChar(40)
  deliveryMethodName String @map("delivery_method_name") @db.VarChar(160)

  customerEmail String @map("customer_email") @db.VarChar(320)
  customerName  String @map("customer_name") @db.VarChar(160)
  customerPhone String @map("customer_phone") @db.VarChar(32)

  shippingRecipientName String @map("shipping_recipient_name") @db.VarChar(160)
  shippingPhone         String @map("shipping_phone") @db.VarChar(32)
  shippingCountryCode   String @default("BY") @map("shipping_country_code") @db.Char(2)
  shippingRegion        String @map("shipping_region") @db.VarChar(80)
  shippingCity          String @map("shipping_city") @db.VarChar(80)
  shippingStreet        String @map("shipping_street") @db.VarChar(160)
  shippingPostalCode    String @map("shipping_postal_code") @db.VarChar(16)

  /// Frozen copy of the placed order (items, totals, address, method).
  /// Queryable history lives in columns; this is the verbatim document.
  placedSnapshot Json @map("placed_snapshot")

  placedAt     DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason") @db.VarChar(240)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  refunds    Refund[]
  delivery       Delivery?
  deliveryMethod DeliveryMethod @relation(fields: [deliveryMethodCode], references: [code], onDelete: Restrict)
  reservations   InventoryReservation[]

  @@index([userId, placedAt(sort: Desc)], map: "orders_user_id_placed_at_idx")
  @@index([status, placedAt(sort: Desc)], map: "orders_status_placed_at_idx")
  @@index([paymentStatus, placedAt(sort: Desc)], map: "orders_payment_status_placed_at_idx")
  @@index([fulfillmentStatus, placedAt(sort: Desc)], map: "orders_fulfillment_status_placed_at_idx")
  @@index([placedAt(sort: Desc)], map: "orders_placed_at_idx")
  @@map("orders")
}

model OrderItem {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String @map("order_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  sku         String @db.VarChar(64)
  productName String @map("product_name") @db.VarChar(200)
  brandName   String @map("brand_name") @db.VarChar(160)
  frameSize   String @map("frame_size") @db.VarChar(16)
  color       String @db.VarChar(80)

  quantity       Int
  unitPriceMinor Int @map("unit_price_minor")
  lineTotalMinor Int @map("line_total_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([productVariantId], map: "order_items_product_variant_id_idx")
  @@map("order_items")
}

// ===========================================================================
// payments
// Owns: payment attempts, the webhook/event log, and refunds.
// Does not write order rows. Idempotency is on (provider, provider_event_id).
// ===========================================================================

model Payment {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  provider            String  @db.VarChar(40)
  providerPaymentId   String? @map("provider_payment_id") @db.VarChar(120)
  amountMinor         Int     @map("amount_minor")
  currency            String  @default("BYN") @db.Char(3)
  status              PaymentStatus @default(PENDING)
  failureCode         String? @map("failure_code") @db.VarChar(80)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]
  refunds Refund[]

  @@unique([provider, providerPaymentId], map: "payments_provider_provider_payment_id_key")
  @@index([orderId, createdAt], map: "payments_order_id_created_at_idx")
  @@index([status, createdAt], map: "payments_status_created_at_idx")
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  provider        String   @db.VarChar(40)
  providerEventId String   @map("provider_event_id") @db.VarChar(120)
  type            String   @db.VarChar(80)
  /// Sanitized, non-PII fields only (amount, status). Raw webhook bodies are
  /// not stored — see docs/architecture.md observability rules.
  data            Json?
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId], map: "payment_events_provider_provider_event_id_key")
  @@index([paymentId, createdAt], map: "payment_events_payment_id_created_at_idx")
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  amountMinor      Int          @map("amount_minor")
  currency         String       @default("BYN") @db.Char(3)
  status           RefundStatus @default(PENDING)
  reason           String?      @db.VarChar(240)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(120)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([providerRefundId], map: "refunds_provider_refund_id_key")
  @@index([paymentId], map: "refunds_payment_id_idx")
  @@index([orderId, createdAt], map: "refunds_order_id_created_at_idx")
  @@map("refunds")
}

// ===========================================================================
// delivery
// Owns: methods, zones (table-driven quotes), and the shipment assignment.
// Quoted cost on the order is historical; zone tariffs may change later.
// ===========================================================================

model DeliveryMethod {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zones   DeliveryZone[]
  shipments Delivery[]
  orders  Order[]

  @@map("delivery_methods")
}

model DeliveryZone {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryMethodId String   @map("delivery_method_id") @db.Uuid
  name             String   @db.VarChar(160)
  /// Empty string means "every city in this region".
  region           String   @db.VarChar(80)
  city             String   @default("") @db.VarChar(80)
  costMinor        Int      @map("cost_minor")
  estimatedDays    Int      @map("estimated_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  method     DeliveryMethod @relation(fields: [deliveryMethodId], references: [id], onDelete: Restrict)
  deliveries Delivery[]

  @@unique([deliveryMethodId, region, city], map: "delivery_zones_method_region_city_key")
  @@index([deliveryMethodId, isActive], map: "delivery_zones_method_id_is_active_idx")
  @@map("delivery_zones")
}

model Delivery {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String               @unique @map("order_id") @db.Uuid
  deliveryMethodId String               @map("delivery_method_id") @db.Uuid
  deliveryZoneId   String?              @map("delivery_zone_id") @db.Uuid
  status           DeliveryRecordStatus @default(ASSIGNED)
  costMinor        Int                  @map("cost_minor")
  trackingNumber   String?              @map("tracking_number") @db.VarChar(80)
  assignedAt       DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(6)
  shippedAt        DateTime?            @map("shipped_at") @db.Timestamptz(6)
  deliveredAt      DateTime?            @map("delivered_at") @db.Timestamptz(6)
  failedAt         DateTime?            @map("failed_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method DeliveryMethod  @relation(fields: [deliveryMethodId], references: [id], onDelete: Restrict)
  zone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  @@index([status, assignedAt], map: "deliveries_status_assigned_at_idx")
  @@map("deliveries")
}

// ===========================================================================
// audit
// Owns: append-only history of who changed what. entity_id is polymorphic on
// purpose — a typed FK per entity would explode this table's shape. Rows are
// never updated or deleted.
// ===========================================================================

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(40)
  entityId     String   @map("entity_id") @db.Uuid
  before       Json?
  after        Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt], map: "audit_logs_entity_created_at_idx")
  @@index([actorUserId, createdAt], map: "audit_logs_actor_created_at_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@map("audit_logs")
}

// ===========================================================================
// inventory
// Owns: on-hand stock, the reservation ledger, and stock movements.
// One inventory item per variant (unique). `available` is generated:
// on_hand - reserved. Reservations are applied by a database trigger so two
// checkouts cannot oversell by doing the arithmetic only in application code.
// See docs/inventory.md and ADR-0014.
// ===========================================================================

model InventoryItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String @unique @map("product_variant_id") @db.Uuid

  /// Physical units in the warehouse. Changed by receipt, adjustment, commit.
  onHand Int @default(0) @map("on_hand")

  /// Units promised to ACTIVE reservations. Changed by reserve/release/expire/commit.
  reserved Int @default(0)

  /// PostgreSQL GENERATED ALWAYS AS (on_hand - reserved) STORED. Read-only.
  available Int @default(dbgenerated("(on_hand - reserved)"))

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant       ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations  InventoryReservation[]
  movements     InventoryMovement[]

  @@map("inventory_items")
}

model InventoryReservation {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String                      @map("inventory_item_id") @db.Uuid
  cartId          String?                     @map("cart_id") @db.Uuid
  orderId         String?                     @map("order_id") @db.Uuid
  quantity        Int
  status          InventoryReservationStatus  @default(ACTIVE)
  expiresAt       DateTime                    @map("expires_at") @db.Timestamptz(6)
  releasedAt      DateTime?                   @map("released_at") @db.Timestamptz(6)
  committedAt     DateTime?                   @map("committed_at") @db.Timestamptz(6)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  cart  Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  @@index([inventoryItemId, status], map: "inventory_reservations_item_status_idx")
  @@index([orderId], map: "inventory_reservations_order_id_idx")
  // Partial indexes in the migration SQL (Prisma cannot express WHERE):
  // inventory_reservations_active_expires_at_idx,
  // inventory_reservations_one_active_per_cart_item_uidx,
  // inventory_reservations_one_active_per_order_item_uidx.
  @@map("inventory_reservations")
}

model InventoryMovement {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String                 @map("inventory_item_id") @db.Uuid
  reservationId   String?                @map("reservation_id") @db.Uuid
  type            InventoryMovementType
  quantity        Int
  onHandAfter     Int                    @map("on_hand_after")
  reservedAfter   Int                    @map("reserved_after")
  note            String?                @db.VarChar(240)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  item        InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt], map: "inventory_movements_item_created_at_idx")
  @@index([reservationId], map: "inventory_movements_reservation_id_idx")
  @@map("inventory_movements")
}
