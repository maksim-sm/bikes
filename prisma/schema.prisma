// Prisma schema for the bikes store.
//
// One file, one database. Table ownership is declared by the section headers
// below and is enforced by review (ADR-0004): a module's repository may only
// touch the tables in its section. Foreign keys across sections are allowed
// for referential integrity; the referencing module still must not *read*
// the referenced table.
//
// Money is integer minor units (kopeks), never floats (ADR-0010).
// Timestamps are timestamptz. Identifiers are UUID v4 generated by Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("product_status")
}

enum ProductMediaRole {
  PRIMARY
  GALLERY

  @@map("product_media_role")
}

// ===========================================================================
// identity
// Owns: users, credentials, roles, customer profiles, addresses, wishlists.
// ===========================================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CUSTOMER)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile   CustomerProfile?
  addresses Address[]
  carts     Cart[]
  wishlist  Wishlist?

  @@index([role], map: "users_role_idx")
  @@map("users")
}

model CustomerProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name") @db.VarChar(80)
  lastName  String   @map("last_name") @db.VarChar(80)
  phone     String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String   @db.VarChar(40)
  recipientName String   @map("recipient_name") @db.VarChar(160)
  phone         String   @db.VarChar(32)
  countryCode   String   @default("BY") @map("country_code") @db.Char(2)
  region        String   @db.VarChar(80)
  city          String   @db.VarChar(80)
  street        String   @db.VarChar(160)
  postalCode    String   @map("postal_code") @db.VarChar(16)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique "one default address per user" is added in the migration SQL:
  // addresses_one_default_per_user_uidx. Prisma cannot express WHERE is_default.
  @@index([userId], map: "addresses_user_id_idx")
  @@map("addresses")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, productId], map: "wishlist_items_wishlist_id_product_id_key")
  @@index([productId], map: "wishlist_items_product_id_idx")
  @@map("wishlist_items")
}

// ===========================================================================
// catalog
// Owns: brands, categories, products, variants, stock, product–media links.
// Does not own: displayed prices (pricing), image bytes (media).
// listPriceMinor on a variant is the catalogue list price in kopeks; what the
// customer is shown is computed by pricing.
// ===========================================================================

model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  locale      String   @default("ru") @db.VarChar(5)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  locale      String   @default("ru") @db.VarChar(5)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId], map: "categories_parent_id_idx")
  @@map("categories")
}

model Product {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId     String        @map("brand_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  slug        String        @unique @db.VarChar(120)
  name        String        @db.VarChar(200)
  description String        @db.Text
  locale      String        @default("ru") @db.VarChar(5)
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  wishlistedBy WishlistItem[]

  // Storefront listing: published products in a category, newest first.
  @@index([categoryId, status, publishedAt(sort: Desc)], map: "products_category_status_published_idx")
  @@index([brandId, status], map: "products_brand_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "products_status_created_idx")
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique @db.VarChar(64)
  frameSize      String   @map("frame_size") @db.VarChar(16)
  color          String   @db.VarChar(80)
  stockQty       Int      @default(0) @map("stock_qty")
  listPriceMinor Int      @map("list_price_minor")
  currency       String   @default("BYN") @db.Char(3)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, frameSize, color], map: "product_variants_product_id_frame_size_color_key")
  @@index([productId, isActive], map: "product_variants_product_id_is_active_idx")
  @@map("product_variants")
}

model ProductMedia {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String            @map("product_id") @db.Uuid
  mediaId   String            @map("media_id") @db.Uuid
  role      ProductMediaRole  @default(GALLERY)
  sortOrder Int               @default(0) @map("sort_order")
  alt       String            @db.VarChar(200)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId], map: "product_media_product_id_media_id_key")
  @@index([productId, sortOrder], map: "product_media_product_id_sort_order_idx")
  @@map("product_media")
}

// ===========================================================================
// media
// Owns: stored objects. Other modules keep opaque keys / mediaId, never URLs.
// ===========================================================================

model MediaAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(100)
  byteSize    Int      @map("byte_size")
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products ProductMedia[]

  @@map("media")
}

// ===========================================================================
// cart
// Owns: carts and line items. Guest carts are keyed by guestToken; a signed-in
// user has at most one cart (partial unique index in the migration SQL).
// ===========================================================================

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId], map: "carts_user_id_idx")
  @@map("carts")
}

model CartItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId], map: "cart_items_cart_id_product_variant_id_key")
  @@index([productVariantId], map: "cart_items_product_variant_id_idx")
  @@map("cart_items")
}
